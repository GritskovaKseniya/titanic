rules_version = '2';

// Public site reads everything (episodes, gallery, team, site settings);
// only the signed-in admin account can write. There's one shared login for
// the whole team, so any authenticated user is trusted — this isn't a
// multi-tenant app with per-user data to separate.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
