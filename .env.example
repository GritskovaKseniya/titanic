# Firebase web app config — from Firebase console: Project settings → General
# → Your apps → Web app → SDK setup and configuration → Config.
# Not secret: this only names the project, it doesn't grant access (that's
# what firestore.rules is for). Copy this file to .env.local for local dev;
# in CI these are set as GitHub repo secrets (see README).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
